# .gitignore
# Standard Python ignores
__pycache__/
*.pyc
*.log
.venv/
venv/
env/
.pipenv/
Pipfile
Pipfile.lock
build/
dist/
.mypy_cache/
.pytest_cache/


# Environment files (avoid committing secrets)
# ignore all .env* files
.env*
# but do NOT ignore the example
!.env.example

# Cloudflare Tunnel credentials (Don't commit secrets)
# Ignore the entire directory first
.cloudflared/

# Now, make an exception for ONLY the config file.
# The leading "!" negates the previous rule for this specific path.
!.cloudflared/config.yml


# Others
test_payload.json
