# .env.example

# WhatsApp / Meta
VERIFY_TOKEN="your_secret_verify_token"  # A secret string you create (How? See 'Secret_Keys_Generation_Commands.md')
WHATSAPP_TOKEN="your_whatsapp_cloud_api_token"
PHONE_NUMBER_ID="your_phone_number_id" # The ID of the phone number sending messages
WHATSAPP_API_VERSION="v22.0"

# OpenAI
OPENAI_API_KEY="sk-..."

# Security for internal APIs (e.g., called by n8n)
INTERNAL_API_KEY="your_super_secret_and_random_api_key_here"
